# Copy to .env.local for local dev; add the same keys in Vercel → Project → Settings → Environment Variables.
# Every key is optional: without them the site still builds, /contact shows a mailto fallback
# and /admin/login explains that Supabase isn't configured.

# Supabase → Project Settings → API (project ref shfdmlraappxyedacmok)
NEXT_PUBLIC_SUPABASE_URL=https://shfdmlraappxyedacmok.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Used by the /contact server action and the login allowlist check.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated admin emails. Access needs BOTH this list and a row in public.admins.
ADMIN_EMAILS=admin@pluck.co.kr

# Optional: Discord channel webhook for new-inquiry alerts (Server Settings → Integrations → Webhooks).
DISCORD_WEBHOOK_URL=

# Optional: salt for hashing visitor IPs (rate limit). Any long random string.
IP_HASH_SALT=

# Dev only: `CRM_FIXTURE=1 npm run dev` previews /admin with fictional demo data, no Supabase needed.
# Ignored in production builds.
# CRM_FIXTURE=1
